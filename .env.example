# 默认离线演示。显式设为 false 进入真实模式。
VITE_USE_MOCK=true
VITE_NOCODB_API_URL=http://localhost:8080/api/v2
VITE_NOCODB_TOKEN=your_token_here
VITE_N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
# 真实模式的手动采集请求使用 X-Hub-Token。此构建变量对浏览器可见。
VITE_WEBHOOK_SECRET=

# 填写 NocoDB 界面显示的真实 Table ID，保留空值以避免误用。
VITE_NOCODB_RSS_SOURCES_TABLE_ID=
# 自动采集频率实际使用的配置表和现有配置行。
VITE_NOCODB_RSS_SYNC_SETTINGS_TABLE_ID=
VITE_NOCODB_RSS_SYNC_SETTINGS_RECORD_ID=
VITE_NOCODB_PRODUCTION_POOL_TABLE_ID=
VITE_NOCODB_RADAR_POOL_TABLE_ID=
VITE_NOCODB_ACCOUNT_METRICS_TABLE_ID=
# 仅调用 listPostMetrics 时需要配置。
VITE_NOCODB_POST_METRICS_TABLE_ID=

# NocoDB 主键字段显示名。自动创建的表可能用 Id。
VITE_NOCODB_ID_FIELD=id
